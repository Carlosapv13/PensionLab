# Variables server-side exclusivas de S4-006 (interpretación IA de la declaración libre).
#
# Deliberadamente SIN prefijo VITE_ — esa es la salvaguarda estructural que impide a Vite
# incluirlas en el bundle del navegador (Vite solo inyecta al cliente las variables
# prefijadas VITE_*). Nunca renombrar estas variables con ese prefijo.
#
# Léelas exclusivamente desde código que viva bajo api/ (nunca importado por src/) — ver
# api/_lib/AdaptadorOpenAI.js.
#
# Sin valor por defecto silencioso: si falta cualquiera de las dos en el entorno de
# ejecución, api/interpretar-declaracion.js debe fallar explícitamente
# (CONFIGURACION_SERVIDOR_INCOMPLETA), nunca continuar con un modelo asumido.

# Credencial de la cuenta de OpenAI usada exclusivamente por api/_lib/AdaptadorOpenAI.js.
OPENAI_API_KEY=

# Identificador del modelo a usar en la Responses API — decisión de producto explícita y
# revisable (mismo tratamiento que otras convenciones del proyecto), nunca hardcodeada en
# el adaptador ni elegida por conveniencia de implementación.
OPENAI_MODEL=
